# 使うAIのキーだけ設定すれば動きます（2つ以上で議論になります）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# モデル（省略時は以下の既定値）
# OPENAI_MODEL=gpt-5
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-2.5-pro

# 結論をまとめるAI（openai / claude / gemini、既定 claude）
# MASTER_PROVIDER=claude

# 最初の見解のあとに行う議論のラウンド数（0〜4、既定 1）
# ROUNDS=1

# PORT=3000
